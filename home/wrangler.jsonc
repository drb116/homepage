{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "family-home",
    "main": "src/index.js",
    "compatibility_date": "2026-08-15",
    "workers_dev": false,
    "vars": {
        "GOOGLE_REDIRECT_URI": "https://home.davidb.xyz/api/google/callback",
        "GOOGLE_CALENDAR_ID": "family10531582547686885726@group.calendar.google.com"
    },
    "routes": [
        {
            "pattern": "home.davidb.xyz",
            "custom_domain": true
        }
    ],
    "assets": {
        "directory": "./public",
        "binding": "ASSETS"
    },
    "d1_databases": [
        {
            "binding": "family_home_db",
            "database_name": "family-home-db",
            "database_id": "57031aa9-bfe4-440d-a302-ed22edd34efc"
        }
    ]
}